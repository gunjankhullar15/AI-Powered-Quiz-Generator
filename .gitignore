# =========================
# Python and FastAPI Project Gitignore
# =========================

# Environment variables
.env
.env.*.local

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Byte-compiled / optimized / DLL files
*.so
*.dll
*.dylib
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# MyPy and type checking
.mypy_cache/
.dmypy.json
dmypy.json

# FastAPI specific
*.db
*.sqlite3

# VSCode and local tools
.vscode/
.history/

# Jupyter notebooks checkpoints
.ipynb_checkpoints

# Local dev files
*.local
*.bak
*.tmp
*.log

# Ignore node_modules if using frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore temporary folders
tmp/
temp/
alembic/versions/*.pyc
alembic/versions/__pycache__/   
alembic/env.pyc
alembic/__pycache__/
alembic.ini
alembic/

app/services/llm_services_async.py
app/services/generate_question_async.py